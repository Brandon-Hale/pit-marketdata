root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
dotnet_diagnostic.CA1062.severity = none
csharp_style_namespace_declarations = file_scoped:warning
# for_non_interface_members, not always: interface members are implicitly public,
# and "always" makes IDE0040 an error on every interface member under
# TreatWarningsAsErrors.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

[*.{tf,tfvars}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2
